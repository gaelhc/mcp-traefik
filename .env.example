# Required: Traefik API URL
TRAEFIK_API_URL=http://localhost:8080

# Authentication Options (choose one):
# Option 1: API Key (Bearer token authentication)
# TRAEFIK_API_KEY=your-api-key-here

# Option 2: Basic Authentication (for Traefik instances secured with basic auth)
# TRAEFIK_BASIC_AUTH_USERNAME=your-username
# TRAEFIK_BASIC_AUTH_PASSWORD=your-password

# Optional: Logging
MCP_LOG_LEVEL=INFO
